{
  "name": "naumi-desktop",
  "version": "0.4.13",
  "private": true,
  "description": "Naumi 企业协作桌面端",
  "author": "Naumi",
  "license": "UNLICENSED",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run icons && npm run installer:ui && npm run stage && node scripts/build-desktop.mjs",
    "build:dir": "npm run icons && npm run installer:ui && npm run stage && node scripts/build-desktop.mjs --dir",
    "test": "node --test tests/*.test.cjs",
    "release": "node ../scripts/publish-desktop-update.mjs",
    "stage": "node ../scripts/build-naumi-layout.mjs && node ../scripts/build-naumi-browser.mjs && node scripts/prepare-runtime.mjs",
    "installer:ui": "node scripts/build-installer-ui.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.naumi.desktop",
    "productName": "Naumi",
    "copyright": "Copyright © Naumi",
    "directories": {
      "output": "../runtime/naumi-desktop-release",
      "buildResources": "app/assets"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../runtime/desktop-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "../runtime/desktop-backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "app/assets/naumi.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Naumi-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Naumi",
      "installerIcon": "app/assets/naumi.ico",
      "uninstallerIcon": "app/assets/naumi.ico",
      "installerHeaderIcon": "app/assets/naumi.ico",
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "useZip": true,
      "differentialPackage": false,
      "include": "installer/maintenance.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JesstLe",
        "repo": "naumi-desktop"
      }
    ],
    "beforePack": "./scripts/verify-staged-runtime.cjs"
  }
}
