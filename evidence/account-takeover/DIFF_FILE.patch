+  const calls=[],authenticate=accountAuthentication({origin:'https://identity.test',adminPolicy,fetcher:async(url,options)=>{calls.push({url,options});if(url.endsWith('/api/auth/session'))return Response.json({user:{email:mode==='foreign-subject'?'other@example.test':subject,role:'admin'}});if(mode==='timeout')throw Error('fixture-timeout');if(mode==='404')return Response.json({},{status:404});if(mode==='non-json')return new Response('<html>',{headers:{'Content-Type':'text/html'}});if(mode==='oversize')return new Response('x'.repeat(524289),{headers:{'Content-Type':'application/json'}});return Response.json({enterprise:mode==='missing-enterprise'?undefined:{id:mode==='wrong-enterprise'?'00000000-0000-4000-8000-000000000000':enterpriseId},actor:mode==='missing-actor'?undefined:{owner:mode==='not-owner'?false:mode==='owner-string'?'true':mode==='role-admin-only'?undefined:true,canManageIdentity:true,role:'admin'}});}});
