+import {DatabaseSync} from 'node:sqlite';
+import {randomBytes,createHash} from 'node:crypto';
+import {email,digest,fault} from './registry.mjs';
+const sha=x=>createHash('sha256').update(x).digest('hex');
+export class AccountModelStore{
+ constructor(file,{clock=Date.now}={}){this.clock=clock;this.db=new DatabaseSync(file);this.db.exec(`PRAGMA journal_mode=WAL;PRAGMA synchronous=FULL;PRAGMA busy_timeout=5000;
+ CREATE TABLE IF NOT EXISTS grants(subject TEXT PRIMARY KEY,revision INTEGER NOT NULL,policy_revision INTEGER NOT NULL,enabled INTEGER NOT NULL,routes TEXT NOT NULL,updated_at INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS operations(id TEXT PRIMARY KEY,fingerprint TEXT NOT NULL,result TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS leases(token_hash TEXT PRIMARY KEY,subject TEXT NOT NULL,device TEXT NOT NULL,revision INTEGER NOT NULL,catalog_hash TEXT NOT NULL,expires INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS requests(id TEXT PRIMARY KEY,subject TEXT NOT NULL,route TEXT NOT NULL,state TEXT NOT NULL,at INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS audit(id INTEGER PRIMARY KEY,actor TEXT NOT NULL,subject TEXT NOT NULL,revision INTEGER NOT NULL,at INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS monotonic(singleton INTEGER PRIMARY KEY CHECK(singleton=1),now INTEGER NOT NULL);
+ UPDATE requests SET state='unknown' WHERE state='running';`);}
+ now(){const n=this.clock(),last=this.db.prepare('SELECT now FROM monotonic WHERE singleton=1').get()?.now??0;if(!Number.isSafeInteger(n)||n<last-1000)throw fault('ACCOUNT_MODEL_CLOCK_ROLLBACK',503);const next=Math.max(n,last);this.db.prepare('INSERT INTO monotonic VALUES(1,?) ON CONFLICT(singleton) DO UPDATE SET now=excluded.now').run(next);return next;}
