+import test from 'node:test';import assert from 'node:assert/strict';import {AccountModelStream} from '../services/account-models/stream.mjs';
+test('protocol completion is incremental, frame-delimited and strict about the selected wire format',()=>{for(const [api,wire]of [['anthropic-messages','event: message_stop\r\ndata: {"type":"message_stop"}\r\n\r\n'],['openai-responses','data: {"type":\ndata: "response.completed"}\n\n'],['openai-completions',': comment\ndata: [DONE]\n\n']]){const p=new AccountModelStream(api);for(const b of Buffer.from(wire))p.push(Uint8Array.of(b));assert.equal(p.complete,true);p.finish();}const incomplete=new AccountModelStream('anthropic-messages');incomplete.push(Buffer.from('data: {"type":"message_stop"}\n'));assert.equal(incomplete.complete,false);assert.throws(()=>incomplete.finish(),/INCOMPLETE/);const wrong=new AccountModelStream('openai-responses');wrong.push(Buffer.from('data: {"type":"message_stop"}\n\n'));assert.throws(()=>wrong.finish(),/INCOMPLETE/);for(const text of ['data: {"type":"response.failed"}\n\n','event: error\ndata: {}\n\n','data: not-json\n\n'])assert.throws(()=>new AccountModelStream('openai-responses').push(Buffer.from(text)),/UPSTREAM_INVALID/);});
