+// Explicit real-supplier acceptance host. Never a production service entry.
+import fs from 'node:fs';import path from 'node:path';import os from 'node:os';import http from 'node:http';import readline from 'node:readline';import {randomUUID,randomBytes,createHash} from 'node:crypto';import pg from 'pg';
+import {createCredentialReader} from 'naumi-credentials-owner';import {hashPassword} from 'naumi-password-owner';
+import {ImportedRegistry} from '../services/account-models/registry.mjs';import {AccountModelStore} from '../services/account-models/store.mjs';import {accountModelServer} from '../services/account-models/server.mjs';import {accountAuthentication} from '../services/account-models/auth.mjs';
+const run=process.env.NAUMI_LIVE_RUN_ID,authority='https://47.105.59.142';if(process.env.NAUMI_LIVE_SUPPLIER_ACK!=='user-20261123'||!/^[a-f0-9-]{36}$/.test(run??''))throw Error('EXPLICIT_REAL_SUPPLIER_ACK_REQUIRED');
+const home=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-model-real-'+run+'-')),subject='desktop-model-qa-'+run+'@acceptance.naumi.invalid',password=randomBytes(24).toString('base64url'),passwordHash=hashPassword(password),note='account-models-real:'+run;
+const pool=new pg.Pool({connectionString:process.env.DATABASE_URL,max:3,connectionTimeoutMillis:5000,query_timeout:15000}),registry=new ImportedRegistry({pool,credentials:createCredentialReader(pool)}),store=new AccountModelStore(path.join(home,'receipt.sqlite'));
+let created=false,server,control,baseState,closed=false,requests=[];const safe=e=>/^[A-Z][A-Z0-9_]{2,100}$/.test(e?.message??'')?e.message:'LIVE_ACCEPTANCE_FAILED';
+const emit=v=>process.stdout.write(JSON.stringify(v)+'\n');
+async function protectedState(){return (await pool.query(`SELECT 'credentials' AS kind,md5(coalesce(jsonb_agg(to_jsonb(t) ORDER BY id)::text,'')) AS digest FROM app_model_credentials t UNION ALL SELECT 'models',md5(coalesce(jsonb_agg(to_jsonb(t) ORDER BY singleton)::text,'')) FROM app_model_config_state t UNION ALL SELECT 'billing',md5(coalesce(jsonb_agg(to_jsonb(t) ORDER BY version)::text,'')) FROM app_billing_config_versions t`)).rows;}
+async function cleanup(){if(closed)return;closed=true;if(control){control.closeAllConnections();await new Promise(r=>control.close(r));}server?.closeAllConnections();if(server)await new Promise(r=>server.close(r));let removed=0;if(created){const r=await pool.query(`DELETE FROM app_users WHERE email=$1 AND password_hash=$2 AND note=$3 AND role='user' AND credits_total=0 AND credits_used=0 RETURNING email`,[subject,passwordHash,note]);removed=r.rowCount;if(removed!==1)throw Error('QA_ACCOUNT_CLEANUP_CONFLICT');}
+const protectedUnchanged=JSON.stringify(await protectedState())===JSON.stringify(baseState);const receipts=store.db.prepare('SELECT id,route,state FROM requests ORDER BY at,id').all();store.close();await pool.end();emit({type:'final',run,status:protectedUnchanged&&(!created||removed===1)?'PASS':'FAIL',temporaryAccountRemoved:removed,protectedConfigUnchanged:protectedUnchanged,upstreamAttempts:requests,receipts,receiptDirectory:home,globalGrantsChanged:0});}
+try{
+ baseState=await protectedState();const routes=await registry.list(),chosen=[];
+ for(const id of ['deepseek-flash','gpt-6-luna']){const candidates=routes.filter(r=>r.model.id===id);if(candidates.length)chosen.push(candidates.find(r=>id==='gpt-6-luna'&&r.api==='openai-responses')??candidates.find(r=>r.group.toLowerCase().includes(id==='deepseek-flash'?'deepseek':'provider'))??candidates[0]);}
+ if(chosen.length!==2)throw Error('REAL_ROUTE_SELECTION_REQUIRED');
+ await pool.query(`INSERT INTO app_users(email,name,plan,credits_total,credits_used,renews_at,role,banned,note,password_hash,account_expires_at) VALUES($1,$2,'starter',0,0,now()+interval '1 hour','user',false,$3,$4,now()+interval '1 hour')`,[subject,'Naumi 模型闭环验收 '+run,note,passwordHash]);created=true;
+ const originalList=registry.list.bind(registry);registry.list=async()=>{const all=await originalList();return chosen.map(r=>all.find(x=>x.id===r.id)).filter(Boolean);};
+ store.save('operator:real-supplier-acceptance',{subject,expectedRevision:0,enabled:true,routes:chosen.map(r=>r.id),operationId:randomUUID()},chosen.map(r=>r.id));
+ const reserve=http.createServer();await new Promise(r=>reserve.listen(0,'127.0.0.1',r));const port=reserve.address().port;await new Promise(r=>reserve.close(r));const origin='http://127.0.0.1:'+port;
+ server=accountModelServer({store,registry,origin,authenticate:accountAuthentication({origin:authority}),request:async(url,options)=>{const row={requestId:store.db.prepare("SELECT id FROM requests WHERE state='running' ORDER BY at DESC LIMIT 1").get()?.id??null,model:JSON.parse(options.body).model,startedAt:new Date().toISOString()};requests.push(row);try{const r=await fetch(url,options);row.status=r.status;return r;}catch(e){row.status='UNKNOWN';throw e;}}});
+ // Real Canvas auth over HTTPS. Only its cookie transport is scoped to this private loopback deployment.
+ control=http.createServer(async(req,res)=>{if(['/api/auth/login','/api/auth/session','/api/auth/logout'].includes(req.url)){
+ try{const chunks=[];for await(const c of req)chunks.push(c);const r=await fetch(authority+req.url,{method:req.method,redirect:'error',headers:{Accept:'application/json',Origin:authority,...req.headers.cookie?{cookie:req.headers.cookie}:{},...req.method==='POST'?{'Content-Type':'application/json'}:{}},...req.method==='POST'?{body:Buffer.concat(chunks)}:{},signal:AbortSignal.timeout(15000)});const cookies=r.headers.getSetCookie().map(c=>c.replace(/;\s*Secure(?=;|$)/ig,''));res.writeHead(r.status,{'Content-Type':r.headers.get('content-type')??'application/json',...(cookies.length?{'Set-Cookie':cookies}:{})});res.end(await r.text());}catch{res.writeHead(503,{'Content-Type':'application/json'}).end('{"error":"QA_AUTH_UNAVAILABLE"}');}return;
+ }server.emit('request',req,res);});await new Promise(r=>control.listen(port,'0.0.0.0',r));
+ emit({type:'ready',run,port,account:{email:subject,password},routes:chosen.map(r=>({id:r.id,model:r.model.id,api:r.api,group:r.group})),deployment:'isolated-loopback-real-Canvas-auth',temporaryAccountExpiresInSeconds:3600});
+ const lines=readline.createInterface({input:process.stdin});for await(const line of lines){let cmd;try{cmd=JSON.parse(line);}catch{emit({type:'command-error',error:'INVALID_COMMAND'});continue;}
+ if(cmd.action==='revoke'){const g=store.grant(subject);store.save('operator:real-supplier-acceptance',{subject,expectedRevision:g.revision,enabled:false,routes:[],operationId:randomUUID()},chosen.map(r=>r.id));emit({type:'revoked',upstreamAttempts:requests.length});}
+ else if(cmd.action==='status')emit({type:'status',upstreamAttempts:requests,receipts:store.db.prepare('SELECT id,route,state FROM requests ORDER BY at,id').all()});
+ else if(cmd.action==='shutdown')break;
+ }
+ await cleanup();
+}catch(e){emit({type:'failure',error:safe(e)});try{await cleanup();}catch(clean){emit({type:'cleanup-failure',error:safe(clean),temporaryAccountExpiresInSeconds:3600});}process.exitCode=1;}
